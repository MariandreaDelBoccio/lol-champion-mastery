# Copy this file to .env and add your actual Riot API key

# Riot Games API Key
# Get your API key from: https://developer.riotgames.com/
# For local development only - in production, set this in Netlify dashboard
RIOT_API_KEY=RGAPI-your-riot-api-key-here

# Data Dragon version (update as needed)
# Check latest version at: https://ddragon.leagueoflegends.com/api/versions.json
VITE_DDRAGON_VERSION=14.1.1